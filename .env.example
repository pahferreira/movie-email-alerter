# Get a free key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain verified in Resend; onboarding@resend.dev only delivers to your own account address
EMAIL_FROM=onboarding@resend.dev
# Use the local Inngest dev server
INNGEST_DEV=true
PORT=3000
